EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Public same-origin VELYQUA bridge URL. No PRIME secret belongs in EXPO_PUBLIC_*.
EXPO_PUBLIC_VELYQUA_BRIDGE_URL=https://velyqua.vercel.app

# Temporary public web launch. Set to false to restore the owner login gate.
EXPO_PUBLIC_PUBLIC_ACCESS_MODE=true
