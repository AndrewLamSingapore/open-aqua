{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AndrewLamSingapore/open-aqua/research/schema/evidence-record.schema.json",
  "title": "Open Aqua external evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "publisher",
    "published_at",
    "accessed_at",
    "url",
    "evidence_class",
    "domain",
    "signal",
    "open_aqua_relevance",
    "limitations",
    "status"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^OA-SRC-[0-9]{4}$" },
    "title": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "published_at": { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}-[0-9]{2})?$" },
    "accessed_at": { "type": "string", "format": "date" },
    "url": { "type": "string", "format": "uri" },
    "doi": { "type": ["string", "null"] },
    "evidence_class": {
      "enum": ["scientific_report", "official_standard", "commercial_claim", "commercial_observation", "community_signal", "open_dataset"]
    },
    "domain": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "signal": { "type": "string", "minLength": 1 },
    "open_aqua_relevance": { "type": "string", "minLength": 1 },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "status": { "enum": ["active", "expired", "corrected", "retracted", "superseded", "rejected"] },
    "review_due_at": { "type": ["string", "null"], "format": "date" },
    "related_opportunities": { "type": "array", "items": { "type": "string", "pattern": "^OA-OPP-[0-9]{3}$" }, "uniqueItems": true }
  }
}
