{
  "name": "open-aqua",
  "version": "0.6.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test",
    "doctor": "expo-doctor",
    "export:ios": "expo export --platform ios --output-dir dist",
    "release:validate": "node scripts/release-readiness.mjs --source",
    "release:check": "npm run release:check:source",
    "release:check:source": "npm run release:validate && npm run verify && npm run doctor && npm run export:ios",
    "release:check:testflight": "node scripts/release-readiness.mjs --testflight && npm run verify && npm run doctor && npm run export:ios",
    "release:check:production": "node scripts/release-readiness.mjs --production && npm run verify && npm run doctor && npm run export:ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.12",
    "expo-auth-session": "~57.0.6",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-linking": "~57.0.5",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.11",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "expo-doctor": "1.20.2",
    "typescript": "~5.9.2",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "image-size": "2.0.2",
    "uuid": "11.1.1"
  }
}
